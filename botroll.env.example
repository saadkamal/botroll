# Copy to botroll.env (or another name) and fill in. Keep that file out of the
# Docker build folder: even with .dockerignore, a secret next to `docker build .`
# is easy to bake in by mistake.
#
# A $ in the scrypt hash is fine in this file and in single quotes. It breaks
# in Compose files unless you escape it ($$) or quote the value.

BOTROLL_PASSWORD_HASH=scrypt$…
BOTROLL_SECRET=
BOTROLL_PUSH_TOKEN=
BOTROLL_TZ=Europe/London

# Optional: the board's public https address, linked from emails and action payloads.
# BOTROLL_URL=https://botroll.example.com

# Optional board actions (see README, Actions). File at $BOTROLL_DATA/actions.json
# or BOTROLL_ACTIONS, or one trio of variables per bot:
# BOTROLL_ACTION_ASSISTANT_URL=https://hooks.example.com/botroll
# BOTROLL_ACTION_ASSISTANT_SECRET=          # HMAC, 32+ chars; omit if the receiver only takes a header
# BOTROLL_ACTION_ASSISTANT_HEADER=Authorization: Bearer …
# Flags are 1/true/yes/on or 0/false/no/off/empty:
# BOTROLL_ACTIONS_ALLOW_HTTP=0
# BOTROLL_ACTIONS_ALLOW_PRIVATE=0
# BOTROLL_ACTIONS_ALLOW_PORTS=0             # 8080/8443 also allowed when ALLOW_HTTP is on

# Optional email — Railway Free/Trial/Hobby block outbound SMTP, so use Resend
# or Cloudflare's API there, not SMTP or Cloudflare-SMTP.
# BOTROLL_EMAIL_PROVIDER=resend
# BOTROLL_EMAIL_FROM=bots@yourdomain.com
# BOTROLL_EMAIL_TO=you@yourdomain.com
# RESEND_API_KEY=re_…
